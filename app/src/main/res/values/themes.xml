<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen sistem (Android 12+ dan kompatibel ke bawah lewat core-splashscreen) -->
    <style name="Theme.Otacix.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/otacix_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Otacix</item>
    </style>

    <style name="Theme.Otacix" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/otacix_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
